{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|_|(?:cover|park|beach|school|birthday|thank-you-sun|shadows|goodbye-sun|stars|moon-phases|bedtime|\\d+(?:/[^/]+)?)/?$).+)",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/markdown.*" }
      ],
      "destination": "/api/agent-404"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Vary", "value": "Accept" }] }
  ]
}
